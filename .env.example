# PostgreSQL / Neon pooled connection. Never commit a real credential.
DATABASE_URL="postgresql://user:password@your-neon-pooler.neon.tech/neondb?sslmode=require"

# Auth.js — generate a unique random value of at least 32 characters
AUTH_SECRET="replace-with-a-long-random-secret"
AUTH_URL="https://your-project.vercel.app"
PUBLIC_SITE_URL="https://your-project.vercel.app"

# Public settings
NEXT_PUBLIC_SITE_URL="https://your-project.vercel.app"
NEXT_PUBLIC_WHATSAPP_NUMBER="994501234567"
APP_TIMEZONE="Asia/Baku"

# Development seed only. Never use change-me in production.
AUTH_DEMO_ADMIN_EMAIL="admin@bantik.az"
AUTH_DEMO_ADMIN_PASSWORD="change-me"

# One-time production administrator bootstrap
ADMIN_INITIAL_EMAIL=""
ADMIN_INITIAL_PASSWORD=""

# Optional SMTP — either fill all values or leave all empty
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""

# Backup policy
BACKUP_DIR="backups"
BACKUP_RETENTION_COUNT="14"
POSTGRES_BIN="C:\\Program Files\\PostgreSQL\\17\\bin"

# Destructive operations must only be set for the single command that needs them
ALLOW_DATABASE_RESTORE="NO"
ALLOW_PRODUCTION_RESTORE="NO"
ALLOW_PRODUCTION_SEED="NO"
